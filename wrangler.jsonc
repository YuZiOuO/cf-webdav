{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-webdav",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "cache": {
    "enabled": true,
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "webdav",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FileSystemState",
        "class_name": "FileSystemState",
      },
      {
        "name": "WebDavState",
        "class_name": "WebDavState",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["FileSystemState", "WebDavState"],
    },
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.2,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
    },
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
}
