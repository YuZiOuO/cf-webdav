{
  "name": "cf-fs",
  "version": "0.0.0-development",
  "description": "A Cloudflare-native file storage service with WebDAV and browser access.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YuZiOuO/cf-fs.git"
  },
  "homepage": "https://github.com/YuZiOuO/cf-fs#readme",
  "bugs": {
    "url": "https://github.com/YuZiOuO/cf-fs/issues"
  },
  "files": [
    "scripts",
    "src",
    "wrangler.jsonc"
  ],
  "bin": {
    "cf-fs": "scripts/deploy.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "bun run test:rfc && bun run test:litmus",
    "test:rfc": "bun test test/rfc/index.test.ts",
    "test:litmus": "bash test/litmus.sh",
    "test:perf": "k6 run test/load.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "prettier --check . && bun run lint && tsc --noEmit && bun run test"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@xmldom/xmldom": "^0.9.10",
    "execa": "^10.0.1",
    "fast-xml-parser": "5.3.9",
    "fresh": "^0.5.2",
    "hono": "^4.13.2",
    "range-parser": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fresh": "^0.5.3",
    "@types/node": "^26.1.2",
    "@types/range-parser": "^1.2.7",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "semantic-release": "^25.0.9",
    "typescript-eslint": "^8.65.0",
    "wrangler": "^4.114.0"
  }
}
